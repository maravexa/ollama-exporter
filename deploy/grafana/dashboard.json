{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Datasource",
      "description": "Prometheus datasource for ollama-exporter metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Ollama LLM Inference",
  "uid": "ollama-inference-v1",
  "tags": [
    "ollama",
    "llm",
    "inference",
    "ai"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 38,
  "version": null,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(ollama_requests_total{job=\"ollama\"}, endpoint)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 24
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "(sum(ollama_up{job=\"ollama\"})) or vector(0 / 0)",
          "legendFormat": "Reachable",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": "${datasource}",
          "expr": "(count(ollama_up{job=\"ollama\"})) or vector(0 / 0)",
          "legendFormat": "Observed",
          "refId": "B",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Reachable Ollama APIs / exporters with a current status sample. Disappeared scrape targets are not counted; this is not a scrape-target health check. Sparkline shows aggregate history across the selected range; the number is its latest evaluated sample. Missing samples remain Unknown, not a stale last-known value."
    },
    {
      "id": 2,
      "title": "",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 24
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "(sum(ollama_model_loaded{job=\"ollama\"})) or vector(0 / 0)",
          "legendFormat": "Loaded models",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Counts each loaded model on each exporter separately. Sparkline shows aggregate history across the selected range; the number is its latest evaluated sample. Missing samples remain Unknown, not a stale last-known value."
    },
    {
      "id": 3,
      "title": "",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 24
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "(sum(((ollama_model_vram_bytes{job=\"ollama\"}) and ollama_model_loaded{job=\"ollama\"}) or (ollama_model_loaded{job=\"ollama\"} * (0 / 0)))) or vector(0 / 0)",
          "legendFormat": "Model VRAM",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Sum across current model inventory. Unknown if any current model lacks a memory sample. Reported model allocation, not whole-device or dedicated Apple VRAM. Sparkline shows aggregate history across the selected range; the number is its latest evaluated sample. Missing samples remain Unknown, not a stale last-known value."
    },
    {
      "id": 4,
      "title": "",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 24
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
