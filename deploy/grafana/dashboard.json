      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "label_replace((ollama_model_loaded{job=\"ollama\"}) * 1, \"__dashboard_field__\", \"Loaded\", \"\", \"\")",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": "${datasource}",
          "expr": "label_replace((((ollama_model_vram_bytes{job=\"ollama\"}) and ollama_model_loaded{job=\"ollama\"}) or (ollama_model_loaded{job=\"ollama\"} * (0 / 0))) * 1, \"__dashboard_field__\", \"VRAM\", \"\", \"\")",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": "${datasource}",
          "expr": "label_replace((((ollama_tokens_per_second{job=\"ollama\"}) and ollama_model_loaded{job=\"ollama\"}) or (ollama_model_loaded{job=\"ollama\"} * (0 / 0))) * 1, \"__dashboard_field__\", \"Decode\", \"\", \"\")",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": "${datasource}",
          "expr": "label_replace((((ollama_prompt_tokens_per_second{job=\"ollama\"}) and ollama_model_loaded{job=\"ollama\"}) or (ollama_model_loaded{job=\"ollama\"} * (0 / 0))) * 1, \"__dashboard_field__\", \"Prefill\", \"\", \"\")",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": "${datasource}",
          "expr": "label_replace((((sum without (endpoint) (increase(ollama_requests_total{job=\"ollama\",endpoint=~\"$endpoint\"}[24h]))) and ollama_model_loaded{job=\"ollama\"}) or (ollama_model_loaded{job=\"ollama\"} * (0 / 0))) * 1, \"__dashboard_field__\", \"Requests\", \"\", \"\")",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "time_series"
